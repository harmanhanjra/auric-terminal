# MetaTrader 5 (Windows machine with MT5 terminal installed) — the sole market-data authority.
MT5_SYMBOL=XAUUSD
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Autonomous execution caps (money limits use the broker account currency).
MAX_TICK_AGE_SECONDS=15
MAX_TRADE_RISK_PCT=0.5
MAX_PORTFOLIO_RISK_PCT=2
MAX_PORTFOLIO_POSITIONS=3
MAX_EQUITY_DRAWDOWN_PCT=5
MAX_DAILY_TRADES=10
MAX_CONSECUTIVE_LOSSES=3
LOSS_COOLDOWN_SECONDS=900
MAX_SLIPPAGE_POINTS=20
REQUIRE_ECONOMIC_CALENDAR=true

# V3 production controls
# Use development for local experiments. Production requires operator auth in readiness checks.
AURIC_ENV=development
AURIC_EXECUTION_STAGE=paper
AURIC_REQUIRE_AUTH=false
AURIC_AUTH_SECRET=
AURIC_OPERATOR_USERNAME=operator
AURIC_OPERATOR_PASSWORD=
AURIC_SESSION_TTL_SECONDS=28800
AURIC_RATE_LIMIT_BURST=120
AURIC_RATE_LIMIT_PER_SECOND=2
AURIC_RECONCILE_SECONDS=15

# Portfolio-level exposure controls
MAX_GROSS_LEVERAGE=3.0
MAX_SYMBOL_NOTIONAL_PCT=150

# High-impact event guard. Copy config/economic_calendar.example.json and keep it updated
# from a trusted economic-calendar provider before assisted/auto live trading.
ECONOMIC_CALENDAR_FILE=
NEWS_BLACKOUT_MINUTES_BEFORE=15
NEWS_BLACKOUT_MINUTES_AFTER=15

# V2 execution gates. Manual live and autonomous live are intentionally separate.
# Leave BOTH false until paper/shadow validation and broker verification are complete.
ENABLE_LIVE_TRADING=false
ENABLE_AUTO_LIVE_TRADING=false
# Required for all live mutations and for arming AUTO when auto-live is enabled.
AURIC_LIVE_API_KEY=
MAX_LOT=1.0
MAX_DAILY_LOSS=500.0

# Spread limits are measured in broker points, not raw price units.
# Per-symbol values override MAX_SPREAD_POINTS when present.
MAX_SPREAD_POINTS=80
MAX_SPREAD_POINTS_XAUUSD=80
MAX_SPREAD_POINTS_BTCUSD=1500
MAX_SPREAD_POINTS_EURUSD=30

# Strategy engine (optional; defaults shown)
ENGINE_ENABLED=true
# 'auto' selects a regime-appropriate strategy per closed bar (see regime.py).
ENGINE_STRATEGY=auto
# Optional allow-list restricting auto selection, e.g. momentum_breadth_vol,bb_rsi
ENGINE_AUTO_POOL=
ENGINE_TIMEFRAME=M15
ENGINE_RISK_PCT=0.5
ENGINE_SIZER=fixed_fractional
ENGINE_ATR_STOP=1.5
ENGINE_RR=2
ENGINE_TRAIL_ATR=1.0
ENGINE_CONFIRM_MIN=3
ENGINE_PYRAMID_FRAC=0.5
ENGINE_MAX_PYRAMID=0

# Kronos AI confirmation (optional)
ENGINE_KRONOS_CONFIRM=true
KRONOS_POLL_SECONDS=120
KRONOS_LOOKBACK=400
KRONOS_PRED_LEN=60
KRONOS_MODEL=mini
KRONOS_VETO_THRESHOLD=0.3

# Telegram notifications (optional, never commit real values)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
