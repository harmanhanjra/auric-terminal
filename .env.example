# auto | mt5 | twelvedata | web
MARKET_DATA_SOURCE=auto

# Web API fallback (https://twelvedata.com)
TWELVE_DATA_API_KEY=
TWELVE_DATA_SYMBOL=XAU/USD

# MetaTrader 5 (Windows machine with MT5 terminal installed)
MT5_SYMBOL=XAUUSD
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# V2 execution gates. Manual live and autonomous live are intentionally separate.
# Leave BOTH false until paper/shadow validation and broker verification are complete.
ENABLE_LIVE_TRADING=false
ENABLE_AUTO_LIVE_TRADING=false
# Required for all live mutations and for arming AUTO when auto-live is enabled.
AURIC_LIVE_API_KEY=
MAX_LOT=1.0
MAX_DAILY_LOSS=500.0

# Spread limits are measured in broker points, not raw price units.
# Per-symbol values override MAX_SPREAD_POINTS when present.
MAX_SPREAD_POINTS=80
MAX_SPREAD_POINTS_XAUUSD=80
MAX_SPREAD_POINTS_BTCUSD=1500
MAX_SPREAD_POINTS_EURUSD=30

# Strategy engine (optional; defaults shown)
ENGINE_ENABLED=true
ENGINE_STRATEGY=ema144_pullback
ENGINE_TIMEFRAME=M15
ENGINE_RISK_PCT=1
ENGINE_SIZER=fixed_fractional
ENGINE_ATR_STOP=1.5
ENGINE_RR=2
ENGINE_TRAIL_ATR=1.0
ENGINE_CONFIRM_MIN=3
ENGINE_PYRAMID_FRAC=0.5
ENGINE_MAX_PYRAMID=2

# Kronos AI confirmation (optional)
ENGINE_KRONOS_CONFIRM=true
KRONOS_POLL_SECONDS=120
KRONOS_LOOKBACK=400
KRONOS_PRED_LEN=60
KRONOS_MODEL=mini
KRONOS_VETO_THRESHOLD=0.3

# Telegram notifications (optional, never commit real values)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ── V3 production control plane ─────────────────────────────────────────────
# Local development can leave auth off. Production should set this true and
# configure AURIC_API_KEYS_JSON with independent viewer/trader/admin secrets.
AURIC_AUTH_REQUIRED=false
AURIC_API_KEYS_JSON={}
AURIC_EXECUTION_STAGE=paper
AURIC_READ_RPM=240
AURIC_WRITE_RPM=60

# Require every NEW live order to carry an SL; close/protect/cancel remain
# available during circuit halts because they reduce risk.
REQUIRE_LIVE_STOP_LOSS=true

# Portfolio-level risk caps.
MAX_OPEN_POSITIONS=5
MAX_TOTAL_LOTS=5.0
MAX_SYMBOL_LOTS=2.0
MIN_MARGIN_LEVEL_PCT=150
MAX_MARGIN_USAGE_PCT=35
MAX_RISK_PER_TRADE_PCT=2

# Manual/ingested economic-event blackout framework.
NEWS_GUARD_ENABLED=true
NEWS_GUARD_MIN_IMPACT=high

# Broker-state reconciliation cadence.
RECONCILE_INTERVAL_SECONDS=15


# Durable runtime state / backup policy
AURIC_DB_PATH=./auric.db
BACKUP_ENABLED=true
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION=20
AURIC_BACKUP_DIR=./backups

# Autonomous failure-mode circuit breakers
MAX_LIVE_TICK_AGE_MS=5000
HALT_ON_BROKER_DISCONNECT=true
HALT_ON_RECONCILIATION_DRIFT=true
HALT_ON_RECONCILIATION_ERROR=true
REQUIRE_AUTH_FOR_AUTO=true

# Optional normalized economic-calendar feed.
# Expected payload: {"events":[{"title":"...","impact":"high","start_ms":0,
# "end_ms":0,"symbols":["XAUUSD"],"source":"provider"}]}
NEWS_FEED_URL=
NEWS_FEED_API_KEY=
NEWS_FEED_POLL_SECONDS=300
NEWS_FEED_SOURCE=normalized-feed

# Any sensitive value can be mounted instead with a *_FILE variable, e.g.
# AURIC_LIVE_API_KEY_FILE=/run/secrets/auric_live_key
# MT5_PASSWORD_FILE=/run/secrets/mt5_password
# TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_token
# TWELVE_DATA_API_KEY_FILE=/run/secrets/twelve_data_key
# NEWS_FEED_API_KEY_FILE=/run/secrets/news_feed_key
# AURIC_API_KEYS_JSON_FILE=/run/secrets/auric_rbac_keys
