# Auric V3 production template
# Generate long random secrets before use. Never commit a populated .env.

MARKET_DATA_SOURCE=mt5
MT5_SYMBOL=XAUUSD
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Start with all real execution disabled. Promote deliberately after validation.
ENABLE_LIVE_TRADING=false
ENABLE_AUTO_LIVE_TRADING=false
AURIC_EXECUTION_STAGE=shadow

# RBAC is mandatory in production. Format:
# {"viewer-secret":{"name":"viewer","role":"viewer"},"trader-secret":{"name":"trader","role":"trader"},"admin-secret":{"name":"admin","role":"admin"}}
AURIC_AUTH_REQUIRED=true
AURIC_API_KEYS_JSON={}
AURIC_LIVE_API_KEY=

AURIC_READ_RPM=240
AURIC_WRITE_RPM=60
REQUIRE_LIVE_STOP_LOSS=true

MAX_LOT=0.20
MAX_DAILY_LOSS=250
MAX_OPEN_POSITIONS=3
MAX_TOTAL_LOTS=0.60
MAX_SYMBOL_LOTS=0.30
MIN_MARGIN_LEVEL_PCT=200
MAX_MARGIN_USAGE_PCT=25
MAX_RISK_PER_TRADE_PCT=1

MAX_SPREAD_POINTS_XAUUSD=80
MAX_SPREAD_POINTS_BTCUSD=1500
MAX_SPREAD_POINTS_EURUSD=30

NEWS_GUARD_ENABLED=true
NEWS_GUARD_MIN_IMPACT=high
RECONCILE_INTERVAL_SECONDS=10

ENGINE_ENABLED=true
ENGINE_STRATEGY=ema144_pullback
ENGINE_TIMEFRAME=M15
ENGINE_RISK_PCT=0.5
ENGINE_ATR_STOP=1.5
ENGINE_RR=2
ENGINE_TRAIL_ATR=1.0
ENGINE_CONFIRM_MIN=3
ENGINE_PYRAMID_FRAC=0.5
ENGINE_MAX_PYRAMID=1
ENGINE_KRONOS_CONFIRM=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# Durable runtime state / backup policy
AURIC_DB_PATH=./data/auric.db
BACKUP_ENABLED=true
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION=20
AURIC_BACKUP_DIR=./data/backups

# Autonomous failure-mode circuit breakers
MAX_LIVE_TICK_AGE_MS=5000
HALT_ON_BROKER_DISCONNECT=true
HALT_ON_RECONCILIATION_DRIFT=true
HALT_ON_RECONCILIATION_ERROR=true
REQUIRE_AUTH_FOR_AUTO=true

# Optional normalized economic-calendar feed.
# Expected payload: {"events":[{"title":"...","impact":"high","start_ms":0,
# "end_ms":0,"symbols":["XAUUSD"],"source":"provider"}]}
NEWS_FEED_URL=
NEWS_FEED_API_KEY=
NEWS_FEED_POLL_SECONDS=300
NEWS_FEED_SOURCE=normalized-feed

# Any sensitive value can be mounted instead with a *_FILE variable, e.g.
# AURIC_LIVE_API_KEY_FILE=/run/secrets/auric_live_key
# MT5_PASSWORD_FILE=/run/secrets/mt5_password
# TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_token
# TWELVE_DATA_API_KEY_FILE=/run/secrets/twelve_data_key
# NEWS_FEED_API_KEY_FILE=/run/secrets/news_feed_key
# AURIC_API_KEYS_JSON_FILE=/run/secrets/auric_rbac_keys
